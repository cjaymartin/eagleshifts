generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  twoFactorEnabled Boolean?
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id String @id

  accountId String

  providerId String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id String @id

  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model TwoFactor {
  id String @id

  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Organization {
  id String @id

  name        String
  slug        String?
  logo        String?
  createdAt   DateTime     @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  metadata    String?
  members     Member[]
  invitations Invitation[]
  Shift       Shift[]
  profile     OrganizationProfile?

  @@unique([slug])
  @@map("organization")
}

model OrganizationProfile {
  id             String       @id
  organization   Organization @relation(fields: [id], references: [id], onDelete: Cascade)
  weekStart      String       @default("saturday")
  timezone       String       @default("America/New_York")

  // Business notification settings
  digestEmailDate String?

  // Business shift settings
  uploadNames    String?      // Stored as JSON array

  @@map("organization_profile")
}

model Member {
  id String @id

  organizationId String

  name  String?
  image String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  createdAt    DateTime

  icalSlug             String? @unique
  isAvailableByDefault Boolean @default(true)
  phoneNumber          String?
  metadata             String?

  settings       MemberSettings?
  availabilities Availability[]
  shiftAssignments shiftAssignment[]
  shiftRequests  ShiftRequest[]
  logs           LogEntry[]

  @@unique([organizationId, userId])
  @@map("member")
}

model MemberSettings {
  id                    String  @id
  member                Member  @relation(fields: [id], references: [id], onDelete: Cascade)

  // Notification settings
  notifyMeBeforeShift   Boolean @default(false)
  notifyMeBeforeShiftDays String?
  weeklyDigest          Boolean @default(false)
  unfilledDigest        Boolean @default(false)

  @@map("member_settings")
}

model Invitation {
  id String @id

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email        String
  role         String?
  status       String
  expiresAt    DateTime
  inviterId    String
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Shift {
  id             String @id @default(cuid())
  organizationId String

  title      String
  location   String?
  startTime  DateTime
  endTime    DateTime
  slots      Int
  notes      String?
  adminNotes String?
  timezone   String   @default("America/New_York")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  //assignments   Member[]       @relation("ShiftAssignments")
  shiftAssignments shiftAssignment[]
  shiftRequests    ShiftRequest[]
  memberId         String?

  @@map("shift")
}

model Availability {
  id          String   @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  desc        String
  isAvailable Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("availability")
}

model shiftAssignment {
  id        String   @id @default(cuid())
  outcome   String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  shiftId  String
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("shift_assignment")
}

model ShiftRequest {
  id        String   @id @default(cuid())
  status    String // pending, approved, rejected
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  shiftId  String
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("shift_request")
}

model LogEntry {
  id        String   @id @default(cuid())
  action    String
  details   String?
  timestamp DateTime @default(now())

  // Relationships
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("log")
}
