generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  twoFactorEnabled Boolean?
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]

  members     Member[]
  invitations Invitation[]
  logs        LogEntry[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id String @id

  accountId String

  providerId String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id String @id

  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model TwoFactor {
  id String @id

  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model Organization {
  id String @id

  name           String
  // slug           String? // Removed
  logo           String?
  createdAt      DateTime             @default(dbgenerated("LOCALTIMESTAMP")) @db.Timestamp(6)
  metadata       String?
  workosOrganizationId String? @unique // Kept for migration compatibility
  members        Member[]
  invitations    Invitation[]
  Shift          Shift[]
  ShiftDraft     ShiftDraft[]
  profile        OrganizationProfile?
  uploadGroups   UploadGroup[]
  locations      Location[]
  locationGroups LocationGroup[]
  departments    Department[]

  logEntries LogEntry[]
  Checklist  Checklist[]

  // @@unique([slug]) // Removed
  @@map("organization")
}

model OrganizationProfile {
  id           String       @id
  organization Organization @relation(fields: [id], references: [id], onDelete: Cascade)
  weekStart    String       @default("saturday")
  timezone     String       @default("America/New_York")

  // Business notification settings
  digestEmailDate String?

  // Business shift settings
  uploadNames String? // Stored as JSON array

  @@map("organization_profile")
}

model Member {
  id String @id

  organizationId String

  name  String?
  image String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  createdAt    DateTime
  isActivated  Boolean      @default(false)

  icalSlug             String? @unique
  isAvailableByDefault Boolean @default(true)
  phoneNumber          String?
  metadata             String?

  settings                MemberSettings?
  availabilities          Availability[]
  shiftAssignments        shiftAssignment[]
  shiftRequests           ShiftRequest[]
  shiftDrafts             ShiftDraft[]
  uploads                 Upload[]                  @relation("Uploader")
  deletedUploads          Upload[]                  @relation("Deleter")
  ChecklistItemCompletion ChecklistItemCompletion[]

  @@unique([organizationId, userId])
  @@map("member")
}

model MemberSettings {
  id     String @id
  member Member @relation(fields: [id], references: [id], onDelete: Cascade)

  // Notification settings
  notifyMeBeforeShift     Boolean @default(false)
  notifyMeBeforeShiftDays String?
  weeklyDigest            Boolean @default(false)
  unfilledDigest          Boolean @default(false)

  @@map("member_settings")
}

model Invitation {
  id String @id

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email        String
  role         String?
  status       String
  expiresAt    DateTime
  inviterId    String
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Shift {
  id             String @id @default(cuid())
  organizationId String

  title          String
  legacyLocation String?
  locationId     String?
  departmentId   String?
  startTime      DateTime @db.Timestamptz()
  endTime        DateTime @db.Timestamptz()
  slots          Int
  notes          String?
  adminNotes     String?
  timezone       String   @default("America/New_York")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  isCancelled Boolean @default(false)

  // Relationships
  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location                Location?                 @relation(fields: [locationId], references: [id])
  department              Department?               @relation(fields: [departmentId], references: [id])
  // assignments   Member[]       @relation("ShiftAssignments")
  shiftAssignments        shiftAssignment[]
  shiftRequests           ShiftRequest[]
  memberId                String?
  uploads                 Upload[]
  Checklist               Checklist?                @relation(fields: [checklistId], references: [id])
  checklistId             String?
  ChecklistItemCompletion ChecklistItemCompletion[]

  @@map("shift")
}

model Availability {
  id        String   @id @default(cuid())
  startDate DateTime @db.Timestamptz()
  endDate   DateTime @db.Timestamptz()
  startTime Int?
  endTime   Int?

  desc        String
  isAvailable Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("availability")
}

model shiftAssignment {
  id        String   @id @default(cuid())
  outcome   String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  shiftId  String
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("shift_assignment")
}

model ShiftRequest {
  id        String   @id @default(cuid())
  status    String // pending, approved, rejected
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  shiftId  String
  shift    Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("shift_request")
}

model ShiftDraft {
  id             String @id @default(cuid())
  organizationId String
  memberId       String // Required field - draft belongs to a specific member

  title          String
  legacyLocation String?
  locationId     String?
  departmentId   String?
  date           DateTime
  startTime      DateTime? @db.Timestamptz()
  endTime        DateTime? @db.Timestamptz()
  slots          Int
  notes          String?
  adminNotes     String?
  timezone       String    @default("America/New_York")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("shift_draft")
}

model LogEntry {
  id             String   @id @default(cuid())
  organizationId String
  timestamp      DateTime @default(now())
  userId         String
  actionType     String // Enum: LOGIN, SHIFT_CREATE, SHIFT_UPDATE, etc.
  entityId       String? // ID of the related entity (shift, user, etc.)
  entityType     String? // Type of the related entity
  description    String
  metadata       Json? // Additional context data (before/after states, etc.)

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([actionType])
  @@index([entityId])
  @@index([timestamp])
  @@map("log")
}

model UploadGroup {
  id             String   @id @default(cuid())
  organizationId String
  uploadName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isActive       Boolean  @default(true)

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploads      Upload[]

  @@unique([organizationId, uploadName])
  @@map("upload_group")
}

model Upload {
  id            String    @id @default(cuid())
  uploadGroupId String
  shiftId       String
  fileName      String
  fileKey       String    @unique
  fileSize      Int
  fileType      String
  uploadedAt    DateTime  @default(now())
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  // Relationships
  uploadGroup             UploadGroup               @relation(fields: [uploadGroupId], references: [id], onDelete: Cascade)
  shift                   Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  uploaderId              String
  uploader                Member                    @relation("Uploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  deleterId               String?
  deleter                 Member?                   @relation("Deleter", fields: [deleterId], references: [id])
  ChecklistItemCompletion ChecklistItemCompletion[]

  @@map("upload")
}

model LocationGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]

  @@unique([organizationId, name])
  @@map("location_group")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations    Location[]
  shifts       Shift[]
  shiftDrafts  ShiftDraft[]

  @@unique([organizationId, name])
  @@map("department")
}

model Location {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  address             String?
  latitude            Float?
  longitude           Float?
  groupId             String?
  defaultDepartmentId String?
  tags                String? // Stored as JSON array
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationships
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group             LocationGroup? @relation(fields: [groupId], references: [id])
  defaultDepartment Department?    @relation(fields: [defaultDepartmentId], references: [id])
  shifts            Shift[]
  ShiftDraft        ShiftDraft[]

  @@unique([organizationId, name])
  @@map("location")
}

model Checklist {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistItem[]
  shifts       Shift[]

  @@unique([organizationId, name])
  @@map("checklist")
}

model ChecklistItem {
  id                 String   @id @default(cuid())
  name               String
  order              Int
  geoLocationEnabled Boolean  @default(false)
  commentsOption     String // "required", "optional", "off"
  uploadOption       String // "required", "optional", "off"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relationships
  checklistId String
  checklist   Checklist                 @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completions ChecklistItemCompletion[]

  @@map("checklist_item")
}

model ChecklistItemCompletion {
  id          String   @id @default(cuid())
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())
  latitude    Float?
  longitude   Float?
  comments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shiftId         String
  shift           Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  uploadId        String?
  upload          Upload?       @relation(fields: [uploadId], references: [id])

  @@map("checklist_item_completion")
}
