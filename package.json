{
  "name": "eagleshifts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "devhttps": "next dev --experimental-https",
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "build": "npx prisma generate && next build",
    "start": "npx prisma migrate deploy && next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:pull:dev": "dotenv -e .env.local -- npx prisma db pull",
    "db:push:dev": "dotenv -e .env.local -- npx prisma db push",
    "db:migrate:dev": "dotenv -e .env.local -- npx prisma migrate dev",
    "db:migrate:dev:resolve": "dotenv -e .env.local -- npx prisma migrate resolve --applied",
    "db:migrate:dev:deploy": "dotenv -e .env.local -- npx prisma migrate deploy",
    "db:migrate:dev:reset": "dotenv -e .env.local -- npx prisma migrate reset",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:status": "npx prisma migrate status",
    "local:mkadmin": "dotenv -e .env.local -- tsx src/scripts/mkadmin.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.856.0",
    "@aws-sdk/s3-request-presigner": "^3.856.0",
    "@emotion/cache": "^11.14.0",
