    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@mui/system": "^7.3.6",
    "@mui/x-date-pickers": "^8.21.0",
    "@prisma/client": "^7.1.0",
    "@tanstack/react-query": "^5.90.12",
    "@toolpad/core": "^0.16.0",
    "@trpc/client": "^11.7.2",
